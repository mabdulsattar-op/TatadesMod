{
  "name": "Tatade's Mod Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/java:0-21",
  "postCreateCommand": "chmod +x ./gradlew || true && ./gradlew build --no-daemon",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "remoteUser": "vscode"
}
